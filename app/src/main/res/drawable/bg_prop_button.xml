<?xml version="1.0" encoding="utf-8"?>
<!-- "Add Component" button — ghost style: dark fill, 1dp muted border,
     matches the full-width button at the bottom of the Properties panel -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed: slightly lighter surface + cyan border -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/prop_btn_pressed_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/prop_btn_pressed_border" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <!-- Focused (keyboard nav) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/prop_btn_pressed_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/prop_accent_cyan" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <!-- Default -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/prop_btn_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/prop_btn_border" />
            <corners android:radius="4dp" />
        </shape>
    </item>

</selector>
