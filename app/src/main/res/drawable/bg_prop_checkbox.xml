<?xml version="1.0" encoding="utf-8"?>
<!-- Checkbox background — checked state fills with cyan accent (#00D4FF),
     unchecked stays dark with a muted border. Use as android:button on CheckBox. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Checked -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/prop_checkbox_checked_bg" />
            <corners android:radius="2dp" />
        </shape>
    </item>

    <!-- Unchecked -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/prop_checkbox_unchecked_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/prop_checkbox_border" />
            <corners android:radius="2dp" />
        </shape>
    </item>

</selector>
