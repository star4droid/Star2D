<?xml version="1.0" encoding="utf-8"?>
<!-- Color swatch border — the small colored square preview next to the hex
     value in the Tint / color_value row. Set android:background on a View
     whose android:backgroundTint is the actual color. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Tint is applied at runtime; this just provides the border -->
    <solid android:color="#FFFFFFFF" />

    <stroke
        android:width="1dp"
        android:color="@color/prop_swatch_border" />

    <corners android:radius="2dp" />

</shape>
