<?xml version="1.0" encoding="utf-8"?>
<!-- Input field focused/active — cyan border glow, same shape as default -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/prop_input_bg" />

    <stroke
        android:width="1dp"
        android:color="@color/prop_input_border_focused" />

    <corners android:radius="3dp" />

</shape>
