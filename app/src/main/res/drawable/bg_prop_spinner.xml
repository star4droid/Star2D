<?xml version="1.0" encoding="utf-8"?>
<!-- Spinner (dropdown) background — same dark input style with a border.
     The caret/arrow is drawn by the Spinner widget itself or via a layer-list below. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/prop_spinner_bg" />

    <stroke
        android:width="1dp"
        android:color="@color/prop_spinner_border" />

    <corners android:radius="3dp" />

</shape>
