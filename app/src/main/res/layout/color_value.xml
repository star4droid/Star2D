<?xml version="1.0" encoding="utf-8"?><!--
    color_value.xml
    ───────────────
    Fixed-width label (90dp) + color swatch + hex EditText.
    Matches: Tint [■] #FFFFFF

    Runtime — set the swatch color:
        swatch.backgroundTintList =
            ColorStateList.valueOf(Color.parseColor(hexField.text.toString()))
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="18dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="4dp">

    <TextView
        android:layout_width="42dp"
        android:layout_height="wrap_content"
        android:text="Color"
        android:textColor="@color/text_secondary"
        android:textSize="8sp" />

    <View
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginEnd="4dp"
        android:background="#ffffff" />

    <EditText
        android:layout_width="50dp"
        android:layout_height="16dp"
        android:background="@drawable/dark_edit_text"
        android:inputType="text"
        android:paddingStart="2dp"
        android:paddingTop="0dp"
        android:paddingEnd="2dp"
        android:paddingBottom="0dp"
        android:singleLine="true"
        android:text="#FFFFFF"
        android:textColor="@color/text_primary"
        android:textSize="8sp" />
</LinearLayout>