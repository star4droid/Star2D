<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:clipToPadding="true"
    android:background="@color/editor_bg">

    <!-- ==================== Top Toolbar (ControlLayer Top) ==================== -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:id="@+id/top_toolbar"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/toolbar_bg"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <!-- Back -->
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:padding="4dp"
                android:tint="@color/white"
                android:rotation="180"
                android:src="@drawable/back_arrow"
                android:id="@+id/btn_back"
                android:contentDescription="back"/>

            <View
                android:layout_width="1dp"
                android:layout_height="14dp"
                android:background="#444444"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"/>

            <!-- Save -->
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:padding="4dp"
                android:tint="@color/white"
                android:src="@drawable/save_icon"
                android:id="@+id/btn_save"
                android:contentDescription="save"/>

            <!-- Files -->
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:padding="4dp"
                android:src="@drawable/file_white"
                android:id="@+id/btn_files"
                android:contentDescription="files"/>

            <!-- Logs -->
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:padding="4dp"
                android:src="@drawable/assignment"
                android:id="@+id/btn_logs"
                android:contentDescription="logs"/>

            <!-- Rotate Screen -->
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:padding="4dp"
                android:src="@drawable/rotate_dev"
                android:id="@+id/btn_rotate"
                android:contentDescription="rotate screen orientation"/>

            <View
                android:layout_width="1dp"
                android:layout_height="14dp"
                android:background="#444444"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"/>

            <!-- Add Item -->
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:padding="4dp"
                android:src="@drawable/add"
                android:id="@+id/btn_add"
                android:contentDescription="add item"/>

            <!-- Scene Actions -->
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:padding="4dp"
                android:src="@drawable/scene"
                android:id="@+id/btn_scene"
                android:contentDescription="scene actions"/>

            <!-- Scene Color -->
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:padding="4dp"
                android:src="@drawable/color_pal"
                android:id="@+id/btn_color"
                android:contentDescription="scene background color"/>

            <!-- Lock -->
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:padding="4dp"
                android:src="@drawable/lock"
                android:id="@+id/btn_lock"
                android:contentDescription="lock selected item"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <!-- Indexing Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/indexing_label"
                android:text="Indexing..."
                android:textSize="8sp"
                android:textColor="@color/text_muted"
                android:visibility="gone"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ==================== Main Frame: Editor behind, overlay on top ==================== -->
    <FrameLayout
        android:layout_height="0dp"
        android:layout_width="match_parent"
        android:layout_weight="1"
        android:id="@+id/frame">

        <!-- Scene Editor (transparent, renders behind all panels) -->
        <com.star4droid.star2d.Items.Editor
            android:layout_height="match_parent"
            android:layout_width="match_parent"
            android:id="@+id/editor"
            android:background="@android:color/transparent">
        </com.star4droid.star2d.Items.Editor>

        <!-- Overlay panels -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/overlay_controls"
            android:orientation="vertical">

            <!-- ===== Workspace: 3-column layout ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="5"
                android:orientation="horizontal">

                <!-- ===== Left: Hierarchy Panel ===== -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.2"
                    android:id="@+id/left_container"
                    android:background="@color/panel_bg"
                    android:orientation="vertical">

                    <!-- Header bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="22dp"
                        android:background="@color/panel_header_bg"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hierarchy"
                            android:textSize="9sp"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"/>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>

                        <!-- Bodies List (Layer) -->
                    </LinearLayout>

                    <!-- Search bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="2dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_marginBottom="2dp"
                        android:background="@color/comp_header_bg"
                        android:padding="3dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:padding="2dp"
                            android:src="@drawable/search"
                            android:layout_marginEnd="4dp"
                            android:contentDescription="search for item"
                            app:tint="@color/text_muted"/>

                        <EditText
                            android:id="@+id/search_for_item"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Search..."
                            android:background="@android:color/transparent"
                            android:textColorHint="@color/text_muted"
                            android:textColor="@color/text_primary"
                            android:textSize="8sp"
                            android:inputType="text"
                            android:imeOptions="actionSearch"
                            android:singleLine="true"/>
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_light"/>

                    <!-- Current item name -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:gravity="center_vertical"
                        android:paddingStart="4dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:padding="2dp"
                            android:tint="@color/text_primary"
                            android:src="@drawable/ic_filter_black"
                            android:contentDescription="filter"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/item_name"
                            android:paddingStart="4dp"
                            android:textColor="@color/text_primary"
                            android:textSize="9sp"
                            android:text="Scene"/>
                    </LinearLayout>

                    <!-- Items list -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fillViewport="true">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/items_list"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- Left separator -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/border_light"/>

                <!-- ===== Center: Scene Viewport (transparent) ===== -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="4"
                    android:orientation="vertical"
                    android:background="@android:color/transparent">

                    <!-- Scene Tabs -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="22dp"
                        android:scrollbars="none"
                        android:fillViewport="true">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:background="@color/toolbar_bg"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:text="Scene1"
                                android:textSize="9sp"
                                android:textColor="@color/text_white"
                                android:gravity="center"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:background="@color/panel_bg"/>

                            <!-- Add Scene -->
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:padding="4dp"
                                android:src="@drawable/add"
                                android:id="@+id/btn_add_scene"
                                android:contentDescription="add new scene tab"/>

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1"/>
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- ==================== Actions Toolbar (ControlLayer Bottom) ==================== -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="26dp"
                        android:scrollbars="none"
                        android:fillViewport="true">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@color/toolbar_bg"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp">

                            <!-- Play -->
                            <ImageView
                                android:layout_width="27dp"
                                android:layout_height="22dp"
                                android:padding="4dp"
                                android:src="@drawable/play"
                                android:id="@+id/btn_play"
                                android:contentDescription="play scene"/>

                            <!-- Grid (active by default) -->
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:padding="4dp"
                                android:src="@drawable/grid_icon"
                                android:id="@+id/btn_grid"
                                android:contentDescription="grid mode"/>

                            <!-- Move -->
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:padding="4dp"
                                android:src="@drawable/move_icon"
                                android:id="@+id/btn_move"
                                android:contentDescription="move mode"
                                android:layout_marginStart="2dp"/>

                            <!-- Scale -->
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:padding="4dp"
                                android:src="@drawable/scale_icon"
                                android:id="@+id/btn_scale"
                                android:contentDescription="scale mode"
                                android:layout_marginStart="2dp"/>

                            <!-- Rotate -->
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:padding="4dp"
                                android:src="@drawable/rotate_icon"
                                android:id="@+id/btn_rotate_mode"
                                android:contentDescription="rotate mode"
                                android:layout_marginStart="2dp"/>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="14dp"
                                android:background="#444444"
                                android:layout_marginStart="4dp"
                                android:layout_marginEnd="4dp"/>

                            <!-- Delete -->
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:padding="4dp"
                                android:src="@drawable/delete"
                                android:id="@+id/btn_delete"
                                android:contentDescription="delete selected"/>

                            <!-- Undo -->
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:padding="4dp"
                                android:src="@drawable/undo"
                                android:id="@+id/btn_undo"
                                android:contentDescription="undo"/>

                            <!-- Redo -->
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:padding="4dp"
                                android:src="@drawable/redo"
                                android:id="@+id/btn_redo"
                                android:contentDescription="redo"/>

                            <!-- Center Camera -->
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:padding="4dp"
                                android:src="@drawable/center_camera"
                                android:id="@+id/btn_center_camera"
                                android:contentDescription="center camera"/>

                            <!-- Settings -->
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:padding="4dp"
                                android:src="@drawable/events_properties"
                                android:id="@+id/btn_settings"
                                android:contentDescription="settings"/>

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1"/>
                        </LinearLayout>
                    </HorizontalScrollView>
                    <!-- Transparent area with panel toggle buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:background="@android:color/transparent">

                        <!-- Toggle left panel -->
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:rotation="270"
                            android:tint="@color/text_muted"
                            android:id="@+id/open_left_panel"
                            android:src="@drawable/drop_down_icon"
                            android:background="@color/comp_header_bg"
                            android:contentDescription="toggle left panel"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"/>

                        <!-- Toggle right panel -->
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:rotation="90"
                            android:tint="@color/text_muted"
                            android:id="@+id/open_right_panel"
                            android:src="@drawable/drop_down_icon"
                            android:background="@color/comp_header_bg"
                            android:contentDescription="toggle right panel"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Right separator -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/border_light"/>

                <!-- ===== Right: Properties Panel ===== -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.5"
                    android:background="@color/panel_bg"
                    android:id="@+id/right_container"
                    android:orientation="vertical">

                    <!-- Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="22dp"
                        android:background="@color/panel_header_bg"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Properties"
                            android:textSize="9sp"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"/>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>

                        <TextView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:text="≡"
                            android:textSize="9sp"
                            android:textColor="@color/text_muted"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- Properties content -->
                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="3dp"
                            android:paddingEnd="3dp"
                            android:id="@+id/properties_container">

                            <include layout="@layout/section_csv"/>
                            <include layout="@layout/color_value"/>
                            <include layout="@layout/checkbox"/>
                            <include layout="@layout/two_numbers"/>
                            <include layout="@layout/single_number"/>
                            <include layout="@layout/section_csv"/>
                            <include layout="@layout/spinner"/>
                        </LinearLayout>
                    </ScrollView>
                </LinearLayout>

                <!-- Navigation sidebar -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.5"
                    android:id="@+id/navigation_linear"
                    android:orientation="vertical"
                    android:background="@drawable/bg_properties">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:padding="7dp"
                        android:tint="@color/white"
                        android:src="@drawable/layer"
                        android:id="@+id/nav_bodies"
                        android:layout_margin="2dp"
                        android:background="@drawable/bg_button_selected"
                        android:contentDescription="bodies list"/>

                    <!-- Properties -->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:padding="7dp"
                        android:src="@drawable/events_properties"
                        android:id="@+id/nav_properties"
                        android:layout_margin="2dp"
                        android:background="@drawable/bg_button_selected"                        android:contentDescription="properties"/>

                    <!-- Joints -->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:padding="7dp"
                        android:src="@drawable/link"
                        android:id="@+id/nav_joints"
                        android:layout_margin="2dp"
                        android:contentDescription="joints"/>

                    <!-- Events -->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:padding="7dp"
                        android:src="@drawable/pointer_icon"
                        android:id="@+id/nav_events"
                        android:layout_margin="2dp"
                        android:contentDescription="events"/>

                    <!-- Variables -->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:padding="7dp"
                        android:src="@drawable/x"
                        android:id="@+id/nav_variables"
                        android:layout_margin="2dp"
                        android:contentDescription="variables"/>

                    <!-- AI -->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:padding="7dp"
                        android:src="@drawable/gemini"
                        android:id="@+id/nav_ai"
                        android:layout_margin="2dp"
                        android:contentDescription="editor AI"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom separator -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_light"/>

            <!-- ===== Bottom: Assets Tab Bar ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:background="@color/panel_header_bg"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:id="@+id/assets_tab"
                    android:text="Assets"
                    android:textSize="9sp"
                    android:textColor="@color/text_white"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:background="@color/panel_bg"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Anim"
                    android:textSize="9sp"
                    android:textColor="@color/text_muted"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Audio"
                    android:textSize="9sp"
                    android:textColor="@color/text_muted"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Scripts"
                    android:textSize="9sp"
                    android:textColor="@color/text_muted"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
            </LinearLayout>

            <!-- ===== Bottom: Assets Content ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.95"
                android:id="@+id/bottom_panel"
                android:background="@color/panel_bg"
                android:orientation="vertical">

                <include layout="@layout/files_manager_main"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>