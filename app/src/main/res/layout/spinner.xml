<?xml version="1.0" encoding="utf-8"?>
<!--
    spinner.xml
    ───────────
    Fixed-width label (90dp) + Spinner that fills remaining width.
    Matches: Layer [ Background ▾ ]
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:minHeight="30dp">

    <!-- Fixed-width label -->
    <TextView
        android:id="@+id/prop_label"
        android:layout_width="@dimen/value_width"
        android:layout_height="wrap_content"
        android:text="Layer"
        android:textColor="@color/prop_label"
        android:textSize="@dimen/text_size_small"
        android:fontFamily="sans-serif" />

    <!-- Dropdown fills the rest of the row -->
    <Spinner
        android:id="@+id/prop_spinner"
        android:layout_width="0dp"
        android:layout_height="@dimen/value_height"
        android:layout_weight="1"
        android:background="@drawable/bg_prop_spinner"
        android:paddingStart="10dp"
        android:paddingEnd="4dp"
        android:gravity="center_vertical"
        android:popupBackground="@color/prop_surface_elevated"
        android:spinnerMode="dropdown" />

</LinearLayout>