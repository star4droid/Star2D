<?xml version="1.0" encoding="utf-8"?><!--
    two_numbers.xml
    ───────────────
    Fixed-width label (90dp) + two inputs where the axis letter (X/Y or W/H)
    is INSIDE the input box as a non-editable prefix — matching the screenshot
    exactly (letter has the same dark background as the field, separated by a
    thin divider from the number area).

    Matches: Position X[0]  Y[0]  ·  Size W[1920] H[1080]  ·  Scale X[1] Y[1]
-->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="18dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="4dp">

    <TextView
        android:layout_width="42dp"
        android:layout_height="wrap_content"
        android:text="Scale"
        android:textColor="@color/text_secondary"
        android:textSize="8sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="10dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="X"
                android:textColor="@color/label_red"
                android:textSize="8sp" />

            <EditText
                android:layout_width="0dp"
                android:layout_height="16dp"
                android:layout_weight="1"
                android:background="@drawable/dark_edit_text"
                android:inputType="numberDecimal"
                android:paddingStart="2dp"
                android:paddingTop="0dp"
                android:paddingEnd="2dp"
                android:paddingBottom="0dp"
                android:singleLine="true"
                android:text="1"
                android:textColor="@color/text_primary"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="10dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Y"
                android:textColor="@color/label_green"
                android:textSize="8sp" />

            <EditText
                android:layout_width="0dp"
                android:layout_height="16dp"
                android:layout_weight="1"
                android:background="@drawable/dark_edit_text"
                android:inputType="numberDecimal"
                android:paddingStart="2dp"
                android:paddingTop="0dp"
                android:paddingEnd="2dp"
                android:paddingBottom="0dp"
                android:singleLine="true"
                android:text="1"
                android:textColor="@color/text_primary"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>