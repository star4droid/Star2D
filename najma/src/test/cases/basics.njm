# kind: plain
# run: 15|3.5|علي وسارة|صح|7|ب|120|2.5|مرحبا 3|6
مهمة مشترك اختبار(): نص {
    متغير مجموع = ٠
    كرر ٥ مرات باستخدام ع {
        زد مجموع بمقدار ع + ١
    }
    رقم_عشري نصف = ٧ ÷ ٢
    متغير الاسم = "علي"
    متغير جملة = الاسم + " وسارة"
    منطقي كبير = مجموع أكبر من ١٠ و نصف أصغر من أو يساوي ٣٫٥
    متغير عدد = ٠
    لكل ع من ١ إلى ١٠ بخطوة ٢ {
        إذا ع == ٥ { تخطى }
        إذا ع > ٧ { اخرج }
        زد عدد بمقدار ع
    }
    # 1 + 3 + 7 = 11 ... minus nothing: 1+3=4, skip 5, 7 → 11? step: 1,3,5,7,9 → 1+3+7 = 11 then 9 > 7 exit
    اجعل عدد = عدد - ٤
    حرف ح = "أب"[١]
    متغير مضروب = ١
    متغير ك = ٥
    طالما ك > ١ {
        اجعل مضروب = مضروب × ك
        انقص ك
    }
    عشري_دقيق دقيق = ٥ ÷ ٢
    متغير طول_الاسم = طول(الاسم)
    رقم_صحيح باقي_القسمة = ٢٠ باقي ٧
    ارجع "{مجموع}|{نصف}|{جملة}|{كبير ? "صح" : "خطأ"}|{عدد}|{ح}|{مضروب}|{دقيق}|مرحبا {طول_الاسم}|{باقي_القسمة}"
}
