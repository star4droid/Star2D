# kind: plain
# run: كلب: هو هو|قطة: مياو|يطارد|2|خطأ: سيئ|انتهى|40|30
تعداد حالة_الحيوان: يتجول، يطارد، يهاجم

واجهة قابل_للصوت {
    مهمة صوت(): نص
}

مجرد صنف حيوان ينفذ قابل_للصوت {
    نص الاسم
    خاص رقم_صحيح العمر = ١
    عند_الانشاء(نص اسم) {
        اجعل الاسم = اسم
    }
    مهمة وصف(): نص {
        ارجع "{الاسم}: {صوت()}"
    }
    مهمة كبر() { زد العمر }
    مهمة عمره(): رقم_صحيح { ارجع العمر }
}

صنف كلب يرث حيوان {
    عند_الانشاء() { الأب("كلب") }
    مهمة صوت(): نص { ارجع "هو هو" }
}

صنف قطة يرث حيوان {
    حالة_الحيوان الحالة = يتجول
    عند_الانشاء() { الأب("قطة") }
    مهمة صوت(): نص { ارجع "مياو" }
}

صنف classes {
    مشترك ثابت الحد = ٤٠
    مهمة مشترك ضاعف(رقم_صحيح س): رقم_صحيح { ارجع س × ٢ }
    مهمة مشترك اختبار(): نص {
        حيوان ك = جديد كلب()
        متغير ق = جديد قطة()
        اجعل الحالة ق = يطارد
        ك.كبر()
        متغير نتيجة = ""
        حسب الحالة ق {
            حالة يتجول: اجعل نتيجة = "يتجول"
            حالة يطارد، يهاجم:
                اجعل نتيجة = "يطارد"
            الباقي: اجعل نتيجة = "؟"
        }
        متغير خ = ""
        متغير نهاية = ""
        حاول {
            ارمِ خطأ "سيئ"
        } إن حدث خطأ المشكلة {
            اجعل خ = "خطأ: {رسالة المشكلة}"
        } أخيراً {
            اجعل نهاية = "انتهى"
        }
        متغير رقم = ٣٠
        حسب رقم {
            حالة ١٠: اجعل رقم = ١
            الباقي: اجعل رقم = ضاعف(١٥)
        }
        ارجع "{ك.وصف()}|{ق.وصف()}|{نتيجة}|{ك.عمره()}|{خ}|{نهاية}|{الحد}|{رقم}"
    }
}
