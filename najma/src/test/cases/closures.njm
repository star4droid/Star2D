# kind: item
مهمة عد_تنازلي(رقم_صحيح من_رقم) {
    متغير باقٍ = من_رقم
    متغير رسالة = "انطلق"
    كل ثانية {
        انقص باقٍ
        إذا باقٍ <= ٠ { اكتب رسالة }
        بعد ٢٠٠ ملي ثانية { اجعل الشفافية نفسي = باقٍ ÷ ١٠ }
    }
    لكل_عنصر([١، ٢]، (ع) ← { زد باقٍ بمقدار ع })
}
عند النقر {
    عد_تنازلي(٣)
    إذا وُجد الجسم { الجسم.setAwake(صح) }
    إذا نفسي من نوع عنصر و ليس مرئي نفسي { أظهر نفسي }
    اجعل الدوران نفسي = الزاوية_نحو(نفسي، player)
    متغير نسخ = نسخة(coin، ١٠، ٢٠)
    انقل نسخ إلى س نفسي و ص نفسي + ٥٠
}
