# kind: plain
# run: 3|سارة|[10, 30]|60|2|صح|خطأ|5|[3, 2, 1]|ب=2|علي-سارة-محمد|9
مهمة مشترك اختبار(): نص {
    قائمة من نص الأسماء = ["علي"، "سارة"]
    أضف "محمد" إلى الأسماء
    متغير الدرجات = [١٠، ٢٠، ٣٠]
    احذف العنصر رقم ١ من الدرجات
    متغير الكل = [١٠، ٢٠، ٣٠]
    قاموس من نص إلى رقم_صحيح الأسعار = جديد قاموس من نص إلى رقم_صحيح()
    اجعل الأسعار["أ"] = ١
    اجعل الأسعار["ب"] = ٢
    زد الأسعار["ب"] بمقدار ٠
    مصفوفة من رقم_صحيح أرقام = [٣، ١، ٢]
    متغير فيها = الأسماء تحتوي "سارة"
    متغير ليس_فيها = أرقام تحتوي ٩
    قائمة_مرتبطة من رقم_صحيح سلسلة = جديد قائمة_مرتبطة من رقم_صحيح()
    سلسلة.أضف(٥)
    مجموعة من نص فريدة = جديد مجموعة من نص()
    فريدة.أضف("س")
    فريدة.أضف("س")
    متغير مرتبة = [١، ٣، ٢]
    رتّب مرتبة تنازلياً
    متغير نص_القاموس = ""
    لكل مفتاح في الأسعار {
        إذا مفتاح == "ب" { اجعل نص_القاموس = "{مفتاح}={الأسعار[مفتاح]}" }
    }
    متغير كبيرة = فلتر(الكل، (ع) ← ع > ١٥)
    متغير أول_كبير = جد(الكل، (ع) ← ع > ١٥)
    اجعل أرقام[٠] = ٩
    ارجع "{عدد الأسماء}|{الأسماء[١]}|{الدرجات}|{مجموع(الكل)}|{طول(كبيرة)}|{فيها ? "صح" : "خطأ"}|{ليس_فيها ? "صح" : "خطأ"}|{سلسلة.خذ(٠)}|{مرتبة}|{نص_القاموس}|{ادمج(الأسماء، "-")}|{أرقام[٠]}"
}
