# kind: item
# elements: known
خاصية السرعة = 200
متغير النقاط = 0
قائمة من نص أسماء = ["a"، "b"]
تعداد حالة_العدو: يتجول، يطارد
حالة_العدو الحالة = يتجول

كل إطار {
    إذا مفتاح_مضغوط("يمين") { حرك نفسي يميناً بسرعة السرعة } وإلا { اجعل سرعة_س نفسي = 0 }
    إذا لمسة_جديدة() { ادفع نفسي للأعلى بقوة 500 }
    إذا الإدخال.ملموس() أو Gdx.input.isTouched() { toast("hi") }
    player.getBody().setBullet(صح)
    اجعل س player = 100
    متغير موضعه = player.س + ص player
    متغير م = متجه2(1، 2)
    متغير ح = أسماء.حجم() + طول(أسماء)
    اجعل أسماء[0] = "z"
    انقص النقاط
    أخفِ coin
    أظهر coin
    دوّر نفسي بزاوية 5
    غير صورة نفسي إلى "/a.png"
    هز الكاميرا بقوة 4
    تقريب_الكاميرا(1.5)
    متغير رقم = رقم_صحيح("12") + رقم_صحيح(2.7)
    متغير كتابة = نص(رقم) + نص(1.5)
    رقم_عشري عشري = رقم_عشري("1.5")
    إذا الحالة == يطارد أو الحالة يساوي يتجول { اجعل الحالة = يطارد }
    إذا النقاط بين 1 و 5 و أسماء تحتوي "a" و ليس حي(enemy) { }
    متغير اختيار = اختر_عشوائيا(أسماء)
    متغير نسبة = احتمال(30٪) ? 1 : 2
    اكتب "النقاط {النقاط} {عشري} {اختيار}"
    لون_الخلفية("#000000")
    اجعل لون نفسي = أحمر
    اجعل نص scoreText = "٥"
    openScene("menu")
    حرك enemy نحو نفسي بسرعة 50
    انقل coin إلى 10 و 20
    أوقف enemy
    شغل صوت "s"
    متغير أقرب = جد(أسماء، (ا) ← طول(ا) > 0)
    لكل_عنصر(أسماء، (ا) ← اطبع(ا))
    رتب أسماء
    أضف "c" إلى أسماء
    احذف "c" من أسماء
    متغير عناصر = [player، enemy]
    لكل ع في عناصر { زد ص ع بمقدار 1 }
    متغير ب = الجسم
    إذا ب موجود { ب.setAwake(صح) }
    متغير عرضه = عرض نفسي × 2 + الارتفاع نفسي ÷ 2
}
عند الاصطدام {
    إذا يبدا_اسمه_ب(الآخر، "coin") { زد النقاط بمقدار 10؛ احذف الآخر؛ اكتب "النقاط: {النقاط}" في scoreText }
}
مهمة اقفز(قوة): منطقي {
    ادفع نفسي للأعلى بقوة قوة
    ارجع صح
}
