استورد com.badlogic.gdx.math.Rectangle باسم مربع
مهمة مشترك اختبار(): نص {
    متغير م = متجه٢(٣، ٤)
    متغير ط = م.طول()
    متجه٢ ن = جديد متجه٢(١، ١)
    ن.أضف(م)
    زد س ن بمقدار ٣
    متغير ل = لون(١، ٠، ٠، ١)
    متغير حمراء = ل.r
    مربع مر = جديد مربع(٠، ٠، ١٠، ١٠)
    متغير داخل = مر.يحتوي(٥، ٥)
    Vector2 v = new_vec()
    متغير أقصى = رياضيات.clamp(٧٫٥، ٠، ٣)
    متغير وسط = الشفافية أحمر ÷ ٢
    ارجع "{ط}|{س ن}|{حمراء}|{داخل ? "صح" : "خطأ"}|{أقصى}|{وسط}"
}
مهمة مشترك new_vec(): Vector2 {
    ارجع جديد Vector2(0, 0)
}
