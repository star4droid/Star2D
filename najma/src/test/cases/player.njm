# kind: item
متغير السرعة = ٢٠٠
خاصية قوة_القفز = ٥٠٠٫٥
رقم_صحيح النقاط = ٠
قائمة من نص الأسماء = ["علي"، "سارة"]

عند البدء {
    اجعل س نفسي = ١٠٠
    اكتب "هيا نلعب!"
    اجعل الكاميرا تتبع نفسي
    كل ثانيتين {
        زد النقاط بمقدار ١
        اكتب "النقاط: {النقاط}" في scoreText
    }
}

كل إطار {
    إذا مفتاح_مضغوط("يمين") {
        حرك نفسي يميناً بسرعة السرعة
    } وإلا إذا مفتاح_مضغوط("يسار") {
        حرك نفسي يساراً بسرعة السرعة
    } وإلا {
        اجعل سرعة_س نفسي = ٠
    }
    إذا لمسة_جديدة() و ص نفسي أقل من ٣٠٠ {
        ادفع نفسي للأعلى بقوة قوة_القفز
    }
    متغير نصف = النقاط ÷ ٢
    متغير م = المسافة_بين(نفسي، enemy)
    إذا م بين ٠ و ٥٠ { اهتزاز(٢٠٠) }
}

عند الاصطدام {
    إذا يبدا_اسمه_ب(الآخر، "coin") {
        زد النقاط بمقدار ١٠
        شغّل صوت "جمع"
        احذف الآخر
        بعد نصف ثانية { اكتب "أحسنت" }
    }
    إذا اسم الآخر == "enemy" { افتح المشهد "خسارة" }
}

مهمة ضاعف(رقم_صحيح ع) {
    ارجع ع × ٢
}

مهمة أعداء_قريبون(قائمة من عنصر الكل): قائمة من عنصر {
    ارجع فلتر(الكل، (ع) ← المسافة_بين(ع، نفسي) < ٢٠٠)
}
