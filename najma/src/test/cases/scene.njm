# kind: scene
# line: 10 getStage().setGravity(0, -800)
# line: 22 najma.N.setVx(getStage(), player, 200)
متغير الوقت = ٠٫٠
ثابت أقصى_حياة = ٣
خاصية الأعداء = [enemy]
راسم_الأشكال الراسم

عند البدء {
    جاذبية(٠، -٨٠٠)
    اجعل الراسم = جديد راسم_الأشكال()
    لون_الخلفية("#202040")
    كل ثانية {
        زد الوقت بمقدار ١
        اجعل نص scoreText = "الوقت {الوقت}"
    }
    toast("hi")
    اجعل التقدم bar = ٥٠
}

كل إطار {
    حرك player يميناً بسرعة ٢٠٠
    إذا الإدخال.ملموس() {
        متغير نقطة = متجه٢(الإدخال.س()، الإدخال.ص())
        اجعل س player = لمس_س
    }
    الراسم.ابدأ(ممتلئ)
    اجعل اللون الراسم = أحمر
    الراسم.دائرة(١٠٠، ١٠٠، ٥٠)
    الراسم.setAutoShapeType(صح)
    الراسم.أنهِ()
    لكل عدو في الأعداء {
        إذا المسافة_بين(عدو، player) < ١٠٠ و حي(عدو) {
            حرك عدو نحو player بسرعة ٨٠
        }
    }
    جافا {
        com.badlogic.gdx.Gdx.gl.glLineWidth(2);
    }
    متغير زر = جديد قابل_للتشغيل() {
        مهمة نفذ() { زد الوقت بمقدار ١ }
    }
    زر.نفذ()
}

عند الإيقاف { احفظ("وقت"، الوقت) }
عند الاستئناف { اجعل الوقت = استرجع("وقت"، ٠٫٠) }
