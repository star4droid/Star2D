new file mode 100644
index 0000000..b76f05c
--- /dev/null
+++ b/src/retarget/human-retargeting/FrameAlignment.ts
@@ -0,0 +1,80 @@
+import { Bone, Euler, Matrix4, Quaternion, type Skeleton, Vector3 } from 'three'
+
+/**
+ * Works out how a target rig is oriented relative to the Mesh2Motion source rig and returns the
+ * rotation that brings the target's body frame (side, up, front) onto the source's.
+ *
+ * Why: the swing-twist retargeting moves joints relative to their own rest pose, but the pelvis /
+ * root motion is written in the rig's own parent space. A rig authored facing another axis
+ * (Z-up rigs, models facing +X or -Z, mirrored exports...) therefore walks sideways, backwards
+ * or tilted while the body itself looks right. This rotation, applied to the top-level bones,
+ * fixes every axis at once (x, y and z), not only the heading.
+ *
+ * The frame is measured from the rest pose: up = pelvis -> head, side = right thigh -> left thigh,
+ * front = side x up. Falls back to the arms when the legs are not mapped. Returns identity
+ * when the bones needed are missing.
+ */
+export class FrameAlignment {
+  public static estimate (
+    source_skeleton: Skeleton, target_skeleton: Skeleton, target_to_source: Map<string, string>
+  ): Quaternion {
+    const source_frame = FrameAlignment.frame_of(source_skeleton, (name) => name)
+    const source_to_target = new Map<string, string>()
+    target_to_source.forEach((source_name, target_name) => source_to_target.set(source_name, target_name))
+    const target_frame = FrameAlignment.frame_of(target_skeleton, (name) => source_to_target.get(name) ?? '')
+    if (source_frame === null || target_frame === null) return new Quaternion()
+
+    // rotation taking target axes onto source axes: R_source * R_target^-1
+    const rotation = new Matrix4().multiplyMatrices(source_frame, target_frame.clone().invert())
+    const result = new Quaternion().setFromRotationMatrix(rotation).normalize()
+    return FrameAlignment.snap_to_axes(result)
+  }
+
+  /**
+   * Rigs differ by whole 90 degree turns about x, y or z (facing +X, -Z, Z-up exports...). A few
+   * degrees of leftover come from pose asymmetry (A-pose vs T-pose), so snap to the nearest of the
+   * 24 axis-aligned rotations when within 25 degrees of one; otherwise keep the measured value.
+   */
+  private static snap_to_axes (measured: Quaternion): Quaternion {
+    let best = new Quaternion()
+    let best_angle = Infinity
+    const e = [0, 1, 2, 3].map((i) => i * Math.PI / 2)
+    const seen: Quaternion[] = []
+    for (const x of e) for (const y of e) for (const z of e) {
+      const q = new Quaternion().setFromEuler(new Euler(x, y, z, 'XYZ')).normalize()
+      if (seen.some((o) => Math.abs(o.dot(q)) > 0.9999)) continue
+      seen.push(q)
+      const angle = 2 * Math.acos(Math.min(1, Math.abs(q.dot(measured))))
+      if (angle < best_angle) { best_angle = angle; best = q }
+    }
+    return best_angle < 25 * Math.PI / 180 ? best : measured
+  }
+
+  /** Body frame as a rotation matrix with columns (side, up, front), or null when bones are missing. */
+  private static frame_of (skeleton: Skeleton, name_for: (m2m_bone: string) => string): Matrix4 | null {
+    const root = skeleton.bones.find((bone) => bone.parent?.type !== 'Bone')
+    root?.updateWorldMatrix(true, true)
+    const position = (m2m_bone: string): Vector3 | null => {
+      const name = name_for(m2m_bone)
+      const bone: Bone | undefined = name === '' ? undefined : skeleton.getBoneByName(name)
+      return bone === undefined ? null : bone.getWorldPosition(new Vector3())
+    }
+
+    const pelvis = position('pelvis')
+    const head = position('head') ?? position('neck_01') ?? position('spine_03')
+    const left = position('thigh_l') ?? position('upperarm_l')
+    const right = position('thigh_r') ?? position('upperarm_r')
+    if (pelvis === null || head === null || left === null || right === null) return null
+
+    const up = head.sub(pelvis)
+    const side = left.sub(right)
+    if (up.lengthSq() < 1e-10 || side.lengthSq() < 1e-10) return null
+    up.normalize()
+    side.normalize()
+    const front = new Vector3().crossVectors(side, up)
+    if (front.lengthSq() < 1e-6) return null // side parallel to up: degenerate
+    front.normalize()
+    side.crossVectors(up, front).normalize() // re-orthogonalise
+    return new Matrix4().makeBasis(side, up, front)
+  }
+}
