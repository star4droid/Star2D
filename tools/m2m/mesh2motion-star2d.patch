diff --git a/src/lib/M2MAppBridge.ts b/src/lib/M2MAppBridge.ts
new file mode 100644
index 0000000..f480770
--- /dev/null
+++ b/src/lib/M2MAppBridge.ts
@@ -0,0 +1,123 @@
+/**
+ * Star2D app bridge (added for the Star2D "M2M Motion" tool; Mesh2Motion itself is MIT © Scott Petrovic).
+ *
+ * Only active when the page runs inside the Star2D Android WebView, which injects `window.M2MHost`.
+ * - the app hands the user's model: window.m2m.loadModel(url, name) → same path as a file picked in the drop zone
+ * - before a skeleton type is used, its skeleton/animation GLBs are asked from the app (downloaded once and cached)
+ * - exported files are sent back to the app in base64 chunks instead of a browser download
+ * - web-only things (survey, donation, external links, other pages) are hidden
+ */
+
+interface M2MHostApi {
+  ready: () => void
+  ensureRig: (rig_key: string, callback_id: string) => void
+  beginFile: (name: string, size: number) => string
+  appendChunk: (id: string, base64: string) => boolean
+  endFile: (id: string) => void
+  failFile: (id: string, message: string) => void
+  notify?: (kind: string, a: number, b: number) => void
+}
+
+declare global {
+  interface Window {
+    M2MHost?: M2MHostApi
+    m2m?: {
+      loadModel: (url: string, name: string) => Promise<void>
+      rigCallback: (callback_id: string, ok: boolean) => void
+    }
+  }
+}
+
+const CHUNK_BYTES = 768 * 1024 // multiple of 3: every chunk is valid base64 on its own
+
+const HIDE_CSS = `
+  nav > div > a:not(#logo-branding), .active-nav-item, #m2m-model-github-link, #nav-support-mesh2motion, #nav-github, #learn-link,
+  .request-animation-link, .anim-request-tile, #props-dock, #build-version,
+  #load-model-tools .alternate-background-section, #load-model-tools > div[style*="font-size: 1.5rem"] { display: none !important; }
+  #logo-branding { pointer-events: none; }
+`
+
+export class M2MAppBridge {
+  private static readonly pending = new Map<string, (ok: boolean) => void>()
+  private static seq = 0
+
+  static active (): boolean {
+    return typeof window !== 'undefined' && window.M2MHost !== undefined
+  }
+
+  /** Star2D app: ask the app to show a (translated) toast. */
+  static notify (kind: string, a: number = 0, b: number = 0): void {
+    window.M2MHost?.notify?.(kind, a, b)
+  }
+
+  static install (): void {
+    if (!this.active()) return
+    window.m2m = {
+      loadModel: async (url: string, name: string) => { await this.load_model(url, name) },
+      rigCallback: (callback_id: string, ok: boolean) => {
+        const resolve = this.pending.get(callback_id)
+        this.pending.delete(callback_id)
+        if (resolve !== undefined) resolve(ok)
+      }
+    }
+    const style = document.createElement('style')
+    style.textContent = HIDE_CSS
+    document.head.appendChild(style)
+    document.querySelector('#logo-branding')?.removeAttribute('href')
+    // desktop layout: lay the page out at least 760 css px wide and let the WebView scale it
+    const meta = document.querySelector('meta[name="viewport"]')
+    if (meta !== null && window.screen.width < 760) meta.setAttribute('content', 'width=760')
+    window.M2MHost?.ready()
+  }
+
+  /** Resolves when the rig's files are on the phone; rejects when they cannot be downloaded. */
+  static async ensure_rig (rig_key: string | undefined): Promise<void> {
+    if (!this.active() || rig_key === undefined) return
+    const id = `rig${++this.seq}`
+    const ok = await new Promise<boolean>((resolve) => {
+      this.pending.set(id, resolve)
+      window.M2MHost?.ensureRig(rig_key, id)
+    })
+    if (!ok) throw new Error(`rig ${rig_key} is not available`)
+  }
+
+  /** Feeds a model from the app through the normal upload input. */
+  private static async load_model (url: string, name: string): Promise<void> {
+    const response = await fetch(url)
+    const blob = await response.blob()
+    const input = document.querySelector<HTMLInputElement>('#model-upload') ?? document.querySelector<HTMLInputElement>('#upload-file')
+    if (input === null) return
+    const transfer = new DataTransfer()
+    transfer.items.add(new File([blob], name))
+    input.files = transfer.files
+    input.dispatchEvent(new Event('change', { bubbles: true }))
+  }
+
+  /** Sends an exported file to the app. */
+  static async send_file (blob: Blob, filename: string): Promise<void> {
+    const host = window.M2MHost
+    if (host === undefined) return
+    const id = host.beginFile(filename, blob.size)
+    try {
+      for (let start = 0; start < blob.size; start += CHUNK_BYTES) {
+        const base64 = await this.base64(blob.slice(start, start + CHUNK_BYTES))
+        if (!host.appendChunk(id, base64)) throw new Error('write failed')
+      }
+      host.endFile(id)
+    } catch (error) {
+      host.failFile(id, error instanceof Error ? error.message : String(error))
+    }
+  }
+
+  private static async base64 (part: Blob): Promise<string> {
+    return await new Promise((resolve, reject) => {
+      const reader = new FileReader()
+      reader.onload = () => {
+        const url = String(reader.result)
+        resolve(url.substring(url.indexOf(',') + 1))
+      }
+      reader.onerror = () => { reject(reader.error ?? new Error('read failed')) }
+      reader.readAsDataURL(part)
+    })
+  }
+}
