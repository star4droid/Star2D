diff --git a/vite.app.config.js b/vite.app.config.js
new file mode 100644
index 0000000..262e004
--- /dev/null
+++ b/vite.app.config.js
@@ -0,0 +1,23 @@
+// Star2D app build of the "Use Your Model" page only (no asset library, no demo/test files).
+// Rigs and animations are downloaded by the app and served from /m2mdata/ (see M2MActivity in Star2D).
+import { resolve } from 'path'
+import { defineConfig } from 'vite'
+import glsl from 'vite-plugin-glsl'
+
+process.env.VITE_M2M_ASSETS_BASE = '/m2mdata/'
+
+export default defineConfig({
+  root: 'src/',
+  publicDir: '../static-app/',
+  base: './',
+  define: { PROCESS_ENV: JSON.stringify({}) },
+  build: {
+    outDir: '../dist-app',
+    assetsDir: 'bundle',
+    emptyOutDir: true,
+    sourcemap: false,
+    chunkSizeWarningLimit: 4000,
+    rollupOptions: { input: { create: resolve(__dirname, 'src/create.html') } }
+  },
+  plugins: [glsl()]
+})
